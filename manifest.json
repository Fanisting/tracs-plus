{
  "manifest_version": 3,
  "name": "TRACS+ Course Info",
  "version": "0.1.0",
  "description": "Unofficial helper for UofT TRACS: adds course names, instructors and TA contacts to the job postings table.",
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "action": {
    "default_title": "TRACS+ guide",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png" }
  },
  "permissions": ["storage", "declarativeNetRequestWithHostAccess"],
  "host_permissions": ["https://api.easi.utoronto.ca/*", "https://tracs.utoronto.ca/*"],
  "background": { "service_worker": "src/background.js" },
  "content_scripts": [
    {
      "matches": ["https://tracs.utoronto.ca/*"],
      "js": ["src/bridge.js"],
      "css": ["src/style.css"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://tracs.utoronto.ca/*"],
      "js": ["src/lib.js", "src/main.js"],
      "world": "MAIN",
      "run_at": "document_idle"
    }
  ]
}
